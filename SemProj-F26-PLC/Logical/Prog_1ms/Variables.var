	calibrationStateFailure : BOOL := FALSE;
	swingupStateFailure : BOOL := FALSE;
	balancingStateFailure : BOOL := FALSE;
	i : INT;
	j : INT;
	cartVelocity : INT := 5000;
	lengthLocal : DINT;
	stopAcc : INT := 400;
	led_ton : TON;
	lengthMm : DINT;
	cartPos : DINT;
	cartPosMm : DINT;
	cartVelCalculated : REAL;
	pendulumPosAbsolute : DINT;
	pendulumPosRad : REAL;
	pendulumVel : REAL;
	pendulumVelRad : REAL;
	data : ARRAY[0..3] OF REAL;
	cartPosLast : DINT;
	pendulumPosLast : ARRAY[0..9] OF DINT;
	errorString : STRING[80];
	iterationCounter : DINT;
	swingupPolarity : SINT;
	swingupVel : INT;
	pendulumPolarity : SINT;
	dataBacklog : ARRAY[0..9,0..3] OF REAL;
	data10ms : ARRAY[0..3] OF REAL;
